# Educo — example environment variables. Copy to .env.local and fill in (never commit real keys).

# Unsplash Access Key — enables LIVE photo search (millions of free photos) in the Background picker.
# Optional: users can also paste their key directly in the app (stored per-browser). Get a free key at
# https://unsplash.com/developers  →  create an app  →  copy the "Access Key".
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

# WhatsApp Cloud API webhook (app/api/webhooks/whatsapp). Both are REQUIRED — without them the webhook refuses
# every request (RA-5): there is no default token.
# The verify token you type into Meta's dashboard when registering the webhook URL (any long random string).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta → your app → App settings → Basic → "App secret". Every POST is checked against X-Hub-Signature-256 with it.
WHATSAPP_APP_SECRET=
