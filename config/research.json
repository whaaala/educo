  "capture": {
    "_comment": "The archive pass (section-kinds.js, the user 2026-10-19: store everything once). Resource types stored; a media file over mediaMaxMB is listed, not stored. jobs = sites read at once, headless.",
    "types": [
      "stylesheet",
      "script",
      "font",
      "image",
      "media",
      "fetch",
      "xhr",
      "other"
    ],
    "mediaMaxMB": 15,
    "jobs": 16,
    "waitDesktopMs": 1200,
    "waitPhoneMs": 900,
    "loadTimeoutMs": 25000,
    "loadWaitMs": 8000
  },
  "components": {
    "_comment": "Each component kind the archive indexes on every page, and the CSS selector that finds it (CP-n starts from this index). Up to perPage instances of each are kept, their HTML capped at htmlMaxChars.",
    "perPage": 6,
    "htmlMaxChars": 30000,
    "selectors": {
      "navigation": "nav, [role=navigation]",
      "menu-button": "button[aria-expanded][aria-controls], [class*=hamburger i], [class*=burger i], [class*=menu-toggle i]",
      "mega-menu": "[class*=mega i][class*=menu i], [class*=dropdown i]",
      "accordion": "details, [class*=accordion i], [class*=faq i] [aria-expanded]",
      "tabs": "[role=tablist], [class*=tabs i]",
      "carousel": "[aria-roledescription=carousel], .swiper, .slick-slider, .splide, .flickity-enabled, .embla, [class*=carousel i], [class*=slider i]",
      "marquee": "marquee, [class*=marquee i], [class*=ticker i]",
      "dialog": "dialog, [role=dialog], [aria-modal=true], [class*=modal i]",
      "form": "form",
      "search": "[role=search], input[type=search], form[action*=search i]",
      "newsletter": "form input[type=email]",
      "button": "button, a[class*=btn i], a[class*=button i], [role=button]",
      "card": "[class*=card i], article",
      "pricing": "[class*=pricing i], [class*=price i][class*=table i], [class*=plan i]",
      "testimonial": "blockquote, [class*=testimonial i], [class*=review i]",
      "stats": "[class*=stat i], [class*=counter i], [class*=metric i]",
      "logo-strip": "[class*=logos i], [class*=clients i], [class*=partners i], [class*=brands i]",
      "team": "[class*=team i], [class*=staff i], [class*=member i]",
      "gallery": "[class*=gallery i], [class*=masonry i], [class*=lightbox i]",
      "table": "table",
      "video": "video, iframe[src*=youtube], iframe[src*=vimeo]",
      "map": "iframe[src*=map], [class*=map i] canvas, .leaflet-container, .mapboxgl-map",
      "breadcrumb": "[aria-label*=breadcrumb i], [class*=breadcrumb i]",
      "pagination": "[aria-label*=pagination i], [class*=pagination i], [class*=pager i]",
      "badge": "[class*=badge i], [class*=tag i], [class*=chip i], [class*=pill i]",
      "alert-bar": "[role=alert], [class*=announcement i], [class*=banner i][class*=top i], [class*=notice i]",
