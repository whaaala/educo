            { "k": "stack", "set": { "gap": 8 }, "c": [
              { "r": "small", "t": "Chair of Governors" }, { "r": "heading", "t": "Mrs Ngozi Eze" },
              { "r": "image", "photo": "staff-5", "alt": "Mrs Ngozi Eze, Chair of Governors", "set": { "ratio": "3 / 4" } },
              { "r": "body", "t": "A parent of two former pupils, she chairs the board of governors." } ] }
          ] }
        ] } ] } },
