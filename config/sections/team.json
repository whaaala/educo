{
  "$comment": "Team (B21 team GRID(4×n) portrait cards — tablet 3–2, phone 2 → 1; C12 staff directory). The 10 Wix Studio designed Team tiles, read 2026-10-19: four portrait cards with a bio 1 · words beside three portraits 1 · a title band over three big portraits 1 · arched portraits in cards 1 · name-only cards 1 · a statement over four portraits with contacts 1 · staggered portraits on a colour band 1 · centred title over four portraits 1 · round faces in a two-by-two list 1 · a colour panel beside a list of staff rows 1. Six portraits in the set (staff-1..5, head-teacher), so every layout shows 3 or 4 people, never more. Trees: lib/section-library.ts SectionNode.",
  "sections": [
    { "id": "team-four-bio-cards", "name": "Four staff cards with a photo and a short bio", "pattern": "B21",
      "tree": { "k": "section", "set": { "paddingTop": 96, "paddingBottom": 96, "paddingLeft": 24, "paddingRight": 24, "gap": 40 },
        "c": [
          { "r": "title", "t": "Meet our teachers" },
          { "k": "grid", "cols": 4, "min": "12rem", "set": { "gap": 24 }, "c": [
            { "k": "card", "tone": "plain", "center": true, "set": { "gap": 8, "padding": 16 }, "c": [
              { "r": "image", "photo": "staff-1", "alt": "Ms Efua Asante, Head of English", "set": { "ratio": "3 / 4" } },
              { "r": "heading", "t": "Ms Efua Asante" }, { "r": "small", "t": "Head of English" },
              { "r": "body", "t": "Fifteen years of teaching, and she still reads aloud to every class on a Friday." },
              { "r": "link", "t": "Email Ms Asante", "to": "mailto:e.asante@greenfield.sch.ng" } ] },
            { "k": "card", "tone": "plain", "center": true, "set": { "gap": 8, "padding": 16 }, "c": [
              { "r": "image", "photo": "staff-2", "alt": "Mr Kwame Mensah, Head of Mathematics", "set": { "ratio": "3 / 4" } },
              { "r": "heading", "t": "Mr Kwame Mensah" }, { "r": "small", "t": "Head of Mathematics" },
              { "r": "body", "t": "Runs the maths club and coached our team to the state olympiad final." },
              { "r": "link", "t": "Email Mr Mensah", "to": "mailto:k.mensah@greenfield.sch.ng" } ] },
            { "k": "card", "tone": "plain", "center": true, "set": { "gap": 8, "padding": 16 }, "c": [
              { "r": "image", "photo": "staff-5", "alt": "Mrs Ngozi Eze, Bursar", "set": { "ratio": "3 / 4" } },
              { "r": "heading", "t": "Mrs Ngozi Eze" }, { "r": "small", "t": "Bursar" },
              { "r": "body", "t": "Your first call for fees, payment plans and bursaries." },
              { "r": "link", "t": "Email Mrs Eze", "to": "mailto:n.eze@greenfield.sch.ng" } ] },
            { "k": "card", "tone": "plain", "center": true, "set": { "gap": 8, "padding": 16 }, "c": [
              { "r": "image", "photo": "staff-4", "alt": "Mr Ibrahim Musa, Head of Sport", "set": { "ratio": "3 / 4" } },
              { "r": "heading", "t": "Mr Ibrahim Musa" }, { "r": "small", "t": "Head of Sport" },
              { "r": "body", "t": "Football, athletics and the inter-house sports day every March." },
              { "r": "link", "t": "Email Mr Musa", "to": "mailto:i.musa@greenfield.sch.ng" } ] }
          ] }
        ] } },
    { "id": "team-leaders-beside-words", "name": "Our leaders: words beside three portraits", "pattern": "B21",
