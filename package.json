{
  "name": "educo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev:admin": "cd apps/admin && next dev --turbopack -p 3001",
    "build:admin": "cd apps/admin && next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "node scripts/patch-vitest-timeout.js",
    "gen:photos": "node scripts/gen-stock-photos.js",
    "gen:icons": "node scripts/gen-icon-svg.js && node scripts/gen-all-icons.js",
    "test:layout": "playwright test tests/e2e/component-layout-invariants.spec.ts --project=desktop-chrome --workers=1",
    "test:layout:export": "playwright test tests/e2e/export-layout-invariants.spec.ts --project=desktop-chrome",
    "test:interactions": "playwright test tests/e2e/interactions.spec.ts --project=desktop-chrome --workers=1",
    "test:distinct": "playwright test tests/e2e/design-distinctness.spec.ts --project=desktop-chrome --workers=1",
    "test:alert": "playwright test tests/e2e/alert-actions.spec.ts --project=desktop-chrome --workers=1",
    "test:multipage": "playwright test tests/e2e/multipage-preview.spec.ts --project=desktop-chrome --workers=1",
    "test:export": "playwright test tests/e2e/exported-site.spec.ts --project=desktop-chrome --workers=1",
    "test:layout:bands": "playwright test tests/e2e/layout-bands.spec.ts --project=desktop-chrome --workers=1",
    "test:advanced-css": "playwright test tests/e2e/advanced-css.spec.ts --project=desktop-chrome --workers=1",
    "test:fonts": "playwright test tests/e2e/export-fonts.spec.ts --project=desktop-chrome --workers=1",
    "test:images": "playwright test tests/e2e/image-intrinsic.spec.ts --project=desktop-chrome --workers=1",
    "test:watch:ui": "playwright test --project=desktop-chrome --workers=1 --headed",
    "test:playwright:ui": "playwright test --ui",
    "test:invariants": "npm run test:layout && npm run test:layout:export && npm run test:interactions && npm run test:distinct && npm run test:alert && npm run test:multipage && npm run test:export && npm run test:layout:bands && npm run test:advanced-css && npm run test:fonts && npm run test:images"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@material-symbols/svg-400": "^0.47.1",
    "@supabase/supabase-js": "^2.77.0",
    "agora-rtc-sdk-ng": "^4.23.0",
    "agora-rtm-sdk": "^2.2.3-1",
    "clsx": "^2.1.1",
    "currency-symbol-map": "^5.1.0",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.16.1",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "ionicons": "^8.1.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.548.0",
    "mp4-muxer": "^5.2.2",
    "next": "15.1.3",
    "pptxgenjs": "^3.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-to-print": "^3.2.0",
    "recharts": "^3.3.0",
    "simple-icons": "^16.29.0",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.70",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.1.3",
    "jsdom": "^26.1.0",
    "playwright-bdd": "^8.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
