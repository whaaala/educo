# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key (server-side only, used for bucket creation)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Payment Gateway (Paystack)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Payment Gateway (Interswitch)
NEXT_PUBLIC_INTERSWITCH_PUBLIC_KEY=your-interswitch-public-key
INTERSWITCH_SECRET_KEY=your-interswitch-secret-key

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# SMS Gateway
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=your-sender-id

# GIPHY (free key from developers.giphy.com)
NEXT_PUBLIC_GIPHY_API_KEY=your-giphy-api-key

# Translation (Tenant-controlled)
# DeepL Free API auth key (used by /api/translate when enabled for a tenant)
DEEPL_AUTH_KEY=your-deepl-auth-key

# Google Cloud Translation (paid)
GOOGLE_CLOUD_TRANSLATE_API_KEY=your-google-cloud-translate-api-key

# Cloud Storage
# Primary: Supabase Storage (uses SUPABASE_SERVICE_ROLE_KEY above for bucket setup)
# Overflow: Dropbox (when Supabase quota exceeded)
# Create a Dropbox app at https://www.dropbox.com/developers/apps
NEXT_PUBLIC_DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret

# Cloud Storage (Google Drive - optional)
# NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=your-google-drive-client-id
# GOOGLE_DRIVE_CLIENT_SECRET=your-google-drive-client-secret

# Cloud Storage (OneDrive - optional)
# NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=your-onedrive-client-id
# ONEDRIVE_CLIENT_SECRET=your-onedrive-client-secret
